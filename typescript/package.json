{
  "name": "@rtemis/a3",
  "version": "0.3.2",
  "description": "Amino Acid Annotation (A3) format — TypeScript implementation",
  "homepage": "https://a3.rtemis.org",
  "keywords": [
    "rtemis",
    "bioinformatics",
    "protein"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/rtemis-org/a3",
    "directory": "typescript"
  },
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "types": "./dist/index-browser.d.ts",
        "default": "./dist/index-browser.js"
      },
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index-browser.d.ts",
      "default": "./dist/index-browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "smoke": "node --input-type=module -e \"await import('@rtemis/a3'); await import('@rtemis/a3/browser')\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "pnpm typecheck && pnpm check && vitest run",
    "check": "biome check src tests",
    "lint": "biome lint src tests",
    "format": "biome format src tests",
    "format:write": "biome format --write src tests",
    "lint:fix": "biome lint --write src tests",
    "fix": "biome check --write src tests",
    "publish:jsr": "deno publish",
    "publish:jsr:dry": "deno publish --dry-run",
    "prepublishOnly": "pnpm test && pnpm build && pnpm smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^25.9.5",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
